# npm Automation token for publishing gin-skills to npmjs.com
# Generate at: https://www.npmjs.com/settings/<username>/tokens
# Token type: Automation (bypasses 2FA OTP in CI/CD)
NPM_TOKEN=npm_your_automation_token_here

# KIE AI API key for ai-asset-generator skill (image/video generation)
# Get from: https://kie.ai
KIE_AI_API_KEY=your_kie_ai_api_key_here

# Sty AI API key for background removal (ai-asset-generator skill)
# Get from: https://api.styai.app
STY_AI_API_KEY=your_sty_ai_api_key_here
